# Production defaults use the same public origin. The reverse proxy must forward
# /api and /sse to the Java backend and serve dist/ with an SPA fallback.
# Override only when the frontend and backend use different public origins.
# Public demo: restricted APIs and no management controls.
# Defaults become /api/demo and /sse/demo when this flag is true.
VITE_PUBLIC_DEMO=false
# Optional overrides; leave unset to use the defaults for the selected build.
# VITE_API_BASE_URL=/api
# VITE_SSE_BASE_URL=/sse
# Use `npm run build -- --base=/admin/` for a management UI under /admin/.
# For the matching protected API gateway, set VITE_API_BASE_URL=/admin/api and
# VITE_SSE_BASE_URL=/admin/sse for that build.
